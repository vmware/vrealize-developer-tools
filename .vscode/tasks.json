{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  // Tasks are shell tasks calling the local gulp, so they don't depend on VS Code's
  // gulp task auto-detection (gulp.autoDetect is "off" by default).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "gulp: watch",
      "type": "shell",
      "command": "npx gulp watch --no-color",
      "problemMatcher": ["$tsc-watch"],
      "isBackground": true,
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "gulp: lint",
      "type": "shell",
      "command": "npx gulp lint --no-color",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "gulp: test",
      "type": "shell",
      "command": "npx gulp test --no-color",
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    }
  ]
}
